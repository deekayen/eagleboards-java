<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>net.deekayen.eagleboards</groupId>
  <artifactId>eagleboardscheduler</artifactId>
  <!-- CalVer: the release date. This versions THIS project, not the inherited
       binary it was reconstructed from; that date is provenance and lives in
       PROVENANCE.md and the decompiled-raw / v2019.06.18-rebuild tags.
       Bump this in the same commit that cuts a release. The release workflow
       refuses to publish when the tag and this value disagree. -->
  <version>2026.09.26</version>
  <packaging>jar</packaging>

  <name>Eagle Board Scheduler</name>
  <description>Check-in and room scheduler for Eagle Scout Boards of Review,
    reconstructed from the inherited EagleBoardScheduler_20190618.jar binary.</description>

  <!-- Contingent: the sources derive from a third party's binary, so this
       grant is effective only once written permission from the original
       author is recorded in NOTICE. See PROVENANCE.md. -->
  <licenses>
    <license>
      <name>Apache-2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>21</maven.compiler.release>
  </properties>

  <dependencies>
    <!-- Current supported Jetty (the original bundled EOL Jetty 8; the
         rebuild was proven against it, then migrated — see PROVENANCE.md).
         Pulls jetty-server core and the jakarta.servlet API transitively. -->
    <dependency>
      <groupId>org.eclipse.jetty.ee11</groupId>
      <artifactId>jetty-ee11-servlet</artifactId>
      <version>12.1.13</version>
    </dependency>
    <!-- Replaces the vendored copy of json-simple 1.1 (frozen in 2012) that
         the original binary carried as shkc.json.simple. -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>2.22.3</version>
    </dependency>
    <!-- Draws the check-in address as a QR code for the tablets at the door
         (CheckInAddress). One small class, no dependencies, MIT. -->
    <dependency>
      <groupId>io.nayuki</groupId>
      <artifactId>qrcodegen</artifactId>
      <version>1.8.0</version>
    </dependency>
  </dependencies>

  <build>
    <finalName>${project.artifactId}-${project.version}</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.2</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>shkc.core.EagleBoardScheduler</mainClass>
                </transformer>
              </transformers>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <exclude>module-info.class</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
